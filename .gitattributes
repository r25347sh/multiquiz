# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.multiquiz text eol=lf
*.mq text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

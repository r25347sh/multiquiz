  question: "FMは一般にAMより雑音に強い。",
  type: "truefalse",
  correct: true,
  note: "正しい（広帯域FMの場合特に）。"
}

{
  question: "C級増幅器は線形性が高く、AM最終段に最適である。",
  type: "truefalse",
  correct: false,
  note: "C級は非線形。AM最終段にはB級やAB級が適する。"
}

{
  question: "スーパーヘテロダイン方式では、受信波を中間周波数に変換する。",
  type: "truefalse",
  correct: true,
  note: "正しい。"
}

{
  question: "受信機の隣接周波数排除能力を表す性能を何というか。",
  type: "input",
  correct: "選択度",
  note: "選択度（セレクティビティ）。"
}

{

  question: "ファラデーの法則で誘導起電力e = −N (dΦ/dt) のNは何を表すか。",
  type: "input",
  correct: "巻数",
  note: "コイルの巻数。"
}

{
  question: "BJTの3端子のうち、制御端子に相当するものは何か。",
  type: "input",
  correct: "ベース",
  note: "ベース電流でコレクタ電流を制御。"
}

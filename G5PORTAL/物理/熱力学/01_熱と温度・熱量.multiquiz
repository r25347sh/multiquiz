section: "2. 熱容量・比熱・熱量"

{
  question: "熱容量 C と質量 m・比熱 c の関係はどれか。",
  type: "single",
  options: ["C = m × c", "C = m / c", "C = m + c", "C = c / m"],
  correct: 0,
  note: "C = m c"
}


  options: ["ΔU = Qin + Wされた", "ΔU = Qin × Wされた", "ΔU = 0 常に", "ΔU = Qin のみ常に"],
  correct: 0,
  note: "ΔU = Qin + Wされた"
}

{
  question: "気体が外部にした仕事を Wした とすると、Wされた = −Wした と書ける。",

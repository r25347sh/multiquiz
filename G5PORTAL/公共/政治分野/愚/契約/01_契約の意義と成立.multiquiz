section: "2. 意思表示と瑕疵"

{
  question: "心裡留保とは何か。",
  type: "single",
  options: ["表意者が真意でないことを知りながら意思表示をすること", "相手方を欺くこと", "強迫により意思表示をすること", "錯誤により意思表示をすること"],
  correct: 0,
  note: "原則有効。相手方が悪意・有過失の場合は無効。"
}

{

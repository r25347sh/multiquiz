  options: ["義務", "自由", "特権", "豁免"],
  correct: 0,
  note: "権利の裏には義務がある場合が多い。"
}

{
  question: "ホーフェルドの権利分析で、他者に対してある行為を要求できる権利を何というか。",
  type: "single",
  options: ["請求権（claim-right）", "特権（privilege）", "権力（power）", "豁免（immunity）"],
  correct: 0,
  note: "Wesley Hohfeldの分析。"
}


  note: ""
}

{
  question: "人は生まれながらに何であるか。漢字2字で答えよ。",
  type: "input",
  correct: "平等",
  note: ""
}

{
  question: "啓蒙思想は理性の力を信じ、迷信や権威からの解放を目指した。",
